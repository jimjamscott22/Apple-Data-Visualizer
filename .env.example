# Copy this file to .env and fill in your MariaDB connection details.
#
# Provision the database, user, and privileges first using the SQL in the
# "Database Setup (MariaDB)" section of README.md, then set these to match
# what you created. See docs/mariadb-migration-plan.md (Phase 1) for context.
#
# .env is gitignored — never commit real credentials.

APPLE_DV_DB_HOST=192.168.1.50
APPLE_DV_DB_PORT=3306
APPLE_DV_DB_NAME=apple_health_data
APPLE_DV_DB_USER=apple_health_user
APPLE_DV_DB_PASSWORD=change-me-strong-password
